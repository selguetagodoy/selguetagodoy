{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selguetagodoy.github.io/research-portfolio.schema.json",
  "title": "Sebastián Elgueta Godoy Research Portfolio",
  "type": "object",
  "required": [
    "schema_version",
    "author",
    "last_updated",
    "projects",
    "interfaces"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "author": {
      "type": "object",
      "required": [
        "name",
        "canonical_url",
        "github"
      ],
      "properties": {
        "name": {
          "const": "Sebastián Elgueta Godoy"
        },
        "canonical_url": {
          "type": "string",
          "format": "uri"
        },
        "github": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "projects": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "scope",
          "description",
          "keywords",
          "landing",
          "repository",
          "concept_doi",
          "version_doi",
          "latest_git_release",
          "latest_citable_version",
          "latest_git_release_url",
          "latest_citable_release_url",
          "citation",
          "data_package",
          "citable_release_date",
          "ro_crate"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "const": "dataset"
          },
          "scope": {
            "type": "string"
          },
          "landing": {
            "type": "string",
            "format": "uri"
          },
          "repository": {
            "type": "string",
            "format": "uri"
          },
          "concept_doi": {
            "type": "string",
            "format": "uri"
          },
          "version_doi": {
            "type": "string",
            "format": "uri"
          },
          "latest_git_release": {
            "type": "string"
          },
          "latest_citable_version": {
            "type": "string"
          },
          "latest_git_release_url": {
            "type": "string",
            "format": "uri"
          },
          "description": {
            "type": "string",
            "minLength": 20
          },
          "keywords": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "latest_citable_release_url": {
            "type": "string",
            "format": "uri"
          },
          "citation": {
            "type": "object",
            "required": [
              "cff",
              "bibtex",
              "codemeta"
            ],
            "properties": {
              "cff": {
                "type": "string",
                "format": "uri"
              },
              "bibtex": {
                "type": "string",
                "format": "uri"
              },
              "codemeta": {
                "type": "string",
                "format": "uri"
              }
            },
            "additionalProperties": false
          },
          "data_package": {
            "type": "string",
            "format": "uri"
          },
          "citable_release_date": {
            "type": "string",
            "format": "date"
          },
          "ro_crate": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "interfaces": {
      "type": "object",
      "required": [
        "research_overview",
        "open_data_catalog",
        "public_dataset_json",
        "methodology",
        "research_status",
        "research_jsonld",
        "atom_feed",
        "json_feed"
      ],
      "properties": {
        "research_overview": {
          "type": "string",
          "format": "uri"
        },
        "open_data_catalog": {
          "type": "string",
          "format": "uri"
        },
        "public_dataset_json": {
          "type": "string",
          "format": "uri"
        },
        "methodology": {
          "type": "string",
          "format": "uri"
        },
        "research_status": {
          "type": "string",
          "format": "uri"
        },
        "research_jsonld": {
          "type": "string",
          "format": "uri"
        },
        "atom_feed": {
          "type": "string",
          "format": "uri"
        },
        "json_feed": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
